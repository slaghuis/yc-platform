{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/identity/identity.user.password_changed.v1.json",
  "title": "identity.user.password_changed.v1",
  "description": "A user's password was changed. Every refresh token the user held is revoked.",
  "type": "object",
  "required": ["user_id", "method", "changed_at"],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "method": {
      "type": "string",
      "enum": ["reset"]
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
