{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/payment/payment.charge_failed.v1.json",
  "title": "payment.charge_failed.v1",
  "description": "A combined authorize-and-capture charge was declined or the customer abandoned it at the gateway (Variant B).",
  "type": "object",
  "required": [
    "transaction_id",
    "session_id",
    "gateway",
    "amount",
    "reason",
    "failed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "The checkout session the payment belongs to."
    },
    "gateway": {
      "type": "string",
      "enum": [
        "stripe",
        "yoco"
      ]
    },
    "amount": {
      "$ref": "../common/money.v1.json"
    },
    "reason": {
      "type": "string",
      "description": "Short machine-readable reason, e.g. card_declined, payment_failed, gateway_error."
    },
    "failed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
