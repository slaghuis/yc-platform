{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/product/product.supplier.created.v1.json",
  "title": "product.supplier.created.v1",
  "description": "A system admin created a supplier for the tenant.",
  "type": "object",
  "required": ["supplier_id", "name", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "supplier_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
