{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/cart/cart.recovery.touched.v1.json",
  "title": "cart.recovery.touched.v1",
  "description": "A recovery reminder touch for an abandoned customer cart (issue #35). Touch 1 is published with cart.abandoned.v1; touches 2 and 3 only if the cart fingerprint is unchanged.",
  "type": "object",
  "required": [
    "cart_id",
    "user_id",
    "cart_type",
    "touch",
    "item_count",
    "quantity",
    "items",
    "abandoned_at",
    "touched_at"
  ],
  "additionalProperties": false,
  "properties": {
    "cart_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "cart_type": {
      "type": "string",
      "description": "The cart type, e.g. shopping."
    },
    "touch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 = first reminder, 2 = follow-up, 3 = final."
    },
    "item_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Lines in the cart at abandon (or last fingerprint)."
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "description": "Units across all lines."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "Cart lines for the reminder template.",
      "items": {
        "type": "object",
        "required": ["sku_id", "quantity"],
        "additionalProperties": false,
        "properties": {
          "sku_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Product name when known at publish time."
          },
          "image_url": {
            "type": "string",
            "description": "Primary product image URL when known at publish time."
          }
        }
      }
    },
    "abandoned_at": {
      "type": "string",
      "format": "date-time"
    },
    "touched_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
