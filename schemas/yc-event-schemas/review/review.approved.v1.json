{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/review/review.approved.v1.json",
  "title": "review.approved.v1",
  "description": "A review was approved and is shown on the product.",
  "type": "object",
  "required": [
    "review_id",
    "product_id",
    "user_id",
    "rating",
    "approved_at",
    "product_stats"
  ],
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "type": "string",
      "format": "uuid"
    },
    "product_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_stats": {
      "$ref": "../common/product_review_stats.v1.json"
    }
  }
}
