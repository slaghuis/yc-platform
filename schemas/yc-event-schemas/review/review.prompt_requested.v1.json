{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/review/review.prompt_requested.v1.json",
  "title": "review.prompt_requested.v1",
  "description": "A delivered order's review prompt is due: yc-message asks the customer to review the products they have not reviewed yet.",
  "type": "object",
  "required": [
    "order_id",
    "order_number",
    "user_id",
    "products",
    "requested_at"
  ],
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_number": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
