{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/shipping/shipping.delivered.v1.json",
  "title": "shipping.delivered.v1",
  "description": "A shipment was delivered. yc-orders moves the order to delivered.",
  "type": "object",
  "required": [
    "shipment_id",
    "order_id",
    "tracking_number",
    "occurred_at"
  ],
  "additionalProperties": false,
  "properties": {
    "shipment_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "tracking_number": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
