{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/inventory/inventory.stock.low_threshold_reached.v1.json",
  "title": "inventory.stock.low_threshold_reached.v1",
  "description": "A tracked SKU's available stock crossed below its low-stock threshold.",
  "type": "object",
  "required": [
    "sku_id",
    "on_hand",
    "reserved",
    "available",
    "low_threshold",
    "reached_at"
  ],
  "additionalProperties": false,
  "properties": {
    "sku_id": {
      "type": "string",
      "format": "uuid"
    },
    "on_hand": {
      "type": "integer",
      "minimum": 0
    },
    "reserved": {
      "type": "integer",
      "minimum": 0
    },
    "available": {
      "type": "integer",
      "description": "on_hand minus reserved. Negative only after an oversell (a reservation committed after it expired)."
    },
    "low_threshold": {
      "type": "integer",
      "minimum": 0
    },
    "reached_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
