{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/product/product.banner.created.v1.json",
  "title": "product.banner.created.v1",
  "description": "A shop admin created a banner for a category.",
  "type": "object",
  "required": ["banner_id", "category_id", "text", "background_image_id", "large_image_id", "sort_order", "created_at"],
  "additionalProperties": false,
  "properties": {
    "banner_id": { "type": "string", "format": "uuid" },
    "category_id": { "type": "string", "format": "uuid" },
    "text": { "type": "string", "minLength": 1, "maxLength": 280 },
    "background_image_id": {
      "type": "string",
      "format": "uuid",
      "description": "yc-image id of the banner background."
    },
    "large_image_id": {
      "type": "string",
      "format": "uuid",
      "description": "yc-image id of the large banner image. It is not the category icon."
    },
    "sort_order": { "type": "integer" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
