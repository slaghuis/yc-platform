{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/product/product.updated.v1.json",
  "title": "product.updated.v1",
  "description": "A shop admin changed a product. Carries the product's new state.",
  "type": "object",
  "required": ["product_id", "name", "status", "is_digital", "category_ids", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "product_id": {
      "type": "string",
      "format": "uuid"
    },
    "supplier_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive"]
    },
    "is_digital": {
      "type": "boolean"
    },
    "category_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
