{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/product/product.category.created.v1.json",
  "title": "product.category.created.v1",
  "description": "A shop admin created a category.",
  "type": "object",
  "required": ["category_id", "name", "slug", "sort_order", "created_at"],
  "additionalProperties": false,
  "properties": {
    "category_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sort_order": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
