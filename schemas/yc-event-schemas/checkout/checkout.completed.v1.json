{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/checkout/checkout.completed.v1.json",
  "title": "checkout.completed.v1",
  "description": "The session completed: payment captured and the order confirmed. yc-cart removes the checked-out quantities from the cart.",
  "type": "object",
  "required": [
    "session_id",
    "user_id",
    "cart_type",
    "order_id",
    "order_number",
    "items",
    "total",
    "completed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "cart_type": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_number": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku_id",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "sku_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1
    },
    "total": {
      "$ref": "../common/money.v1.json"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
