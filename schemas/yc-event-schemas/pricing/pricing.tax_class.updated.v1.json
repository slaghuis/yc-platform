{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/pricing/pricing.tax_class.updated.v1.json",
  "title": "pricing.tax_class.updated.v1",
  "description": "A shop admin changed a tax class or its rules (ADR-016). Carries the class's full new rule set.",
  "type": "object",
  "required": ["class_id", "display_name", "rules", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "class_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["jurisdiction", "rule_name", "rate", "base", "sort_order"],
        "additionalProperties": false,
        "properties": {
          "jurisdiction": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "rule_name": {
            "type": "string",
            "minLength": 1
          },
          "rate": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$",
            "description": "Exact decimal, e.g. \"0.15\"."
          },
          "base": {
            "type": "string",
            "description": "line_total, or line_total_including_<rule_name> for compound taxes."
          },
          "sort_order": {
            "type": "integer"
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
