{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yc/schemas/image/image.processed.v1.json",
  "title": "image.processed.v1",
  "description": "All variants of an image are stored and servable.",
  "type": "object",
  "required": ["image_id", "width", "height", "variants", "processed_at"],
  "additionalProperties": false,
  "properties": {
    "image_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_ref": {
      "type": "string",
      "pattern": "^[a-z]+:[0-9a-f-]{36}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant", "format", "width", "height", "bytes", "url"],
        "additionalProperties": false,
        "properties": {
          "variant": {
            "type": "string",
            "enum": ["original", "xlarge", "large", "medium", "thumbnail"]
          },
          "format": {
            "type": "string",
            "enum": ["jpeg", "png", "webp", "gif"]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
