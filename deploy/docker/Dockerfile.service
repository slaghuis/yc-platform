# syntax=docker/dockerfile:1.6
#
# Shared Dockerfile for all yc-platform services.
# Build with: docker build --build-arg SERVICE=yc-identity -f deploy/docker/Dockerfile.service .

ARG GO_VERSION=1.26

# ─────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS builder
ARG SERVICE
ARG TARGETOS
ARG TARGETARCH
RUN apk add --no-cache git ca-certificates

WORKDIR /src

# Every module listed in go.work must be present, or the build fails.
COPY go.work go.work.sum* ./
COPY libs/ libs/
COPY services/ services/
COPY test/ test/
COPY tools/ tools/

# Build with cache mounts
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    cd services/${SERVICE} && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -ldflags="-s -w -X main.version=$(git describe --tags --always 2>/dev/null || echo dev)" \
      -o /out/service \
      ./cmd/${SERVICE}

# ─────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot AS runtime
ARG SERVICE

LABEL org.opencontainers.image.title="${SERVICE}"
LABEL org.opencontainers.image.source="https://github.com/slaghuis/yc-platform"
LABEL org.opencontainers.image.vendor="slaghuis"

COPY --from=builder /out/service /app/service

USER nonroot:nonroot
EXPOSE 8080

ENTRYPOINT ["/app/service"]
