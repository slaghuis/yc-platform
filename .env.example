# Local development settings. `task bootstrap` copies this to .env (gitignored).
# Values match the Docker Compose dev stack; nothing here is a real secret.

# NATS
NATS_URL=nats://localhost:4222

# OpenTelemetry (Jaeger in the dev stack)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Jaeger accepts traces only; keep metrics in-process locally.
OTEL_METRICS_EXPORTER=none

# S3-compatible object storage (SeaweedFS in the dev stack)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=devkey
S3_SECRET_ACCESS_KEY=devsecret
S3_BUCKET_IMAGES=yc-images

# SMTP (MailHog in the dev stack)
SMTP_ADDR=localhost:1025

# JWT signing keys (generated by scripts/gen-dev-jwt-keys.sh)
YC_IDENTITY_JWT_PRIVATE_KEY_FILE=deploy/compose/dev-keys/jwt-private.pem
YC_IDENTITY_JWT_PUBLIC_KEY_FILE=deploy/compose/dev-keys/jwt-public.pem

# Postgres, one database per service (created by deploy/compose/postgres-init.sh)
YC_ANALYTICS_DB_URL=postgres://yc_analytics_app:devpass@localhost:5432/yc_analytics?sslmode=disable
YC_AUDIT_DB_URL=postgres://yc_audit_app:devpass@localhost:5432/yc_audit?sslmode=disable
YC_CART_DB_URL=postgres://yc_cart_app:devpass@localhost:5432/yc_cart?sslmode=disable
YC_CHECKOUT_DB_URL=postgres://yc_checkout_app:devpass@localhost:5432/yc_checkout?sslmode=disable
YC_IDENTITY_DB_URL=postgres://yc_identity_app:devpass@localhost:5432/yc_identity?sslmode=disable
YC_IMAGE_DB_URL=postgres://yc_image_app:devpass@localhost:5432/yc_image?sslmode=disable
YC_INVENTORY_DB_URL=postgres://yc_inventory_app:devpass@localhost:5432/yc_inventory?sslmode=disable
YC_MESSAGE_DB_URL=postgres://yc_message_app:devpass@localhost:5432/yc_message?sslmode=disable
YC_MONITOR_DB_URL=postgres://yc_monitor_app:devpass@localhost:5432/yc_monitor?sslmode=disable
YC_ORDERS_DB_URL=postgres://yc_orders_app:devpass@localhost:5432/yc_orders?sslmode=disable
YC_PAYMENT_DB_URL=postgres://yc_payment_app:devpass@localhost:5432/yc_payment?sslmode=disable
YC_PREFERENCE_DB_URL=postgres://yc_preference_app:devpass@localhost:5432/yc_preference?sslmode=disable
YC_PRICING_DB_URL=postgres://yc_pricing_app:devpass@localhost:5432/yc_pricing?sslmode=disable
YC_PRODUCT_DB_URL=postgres://yc_product_app:devpass@localhost:5432/yc_product?sslmode=disable
YC_REVIEW_DB_URL=postgres://yc_review_app:devpass@localhost:5432/yc_review?sslmode=disable
YC_SHIPPING_DB_URL=postgres://yc_shipping_app:devpass@localhost:5432/yc_shipping?sslmode=disable

# OAuth. With YC_IDENTITY_OAUTH_FAKE=true (dev only) Google and Facebook
# sign in whatever email the client passes as login_hint; set real dev-app
# credentials instead to use the providers.
YC_IDENTITY_OAUTH_FAKE=true
YC_IDENTITY_GOOGLE_CLIENT_ID=
YC_IDENTITY_GOOGLE_CLIENT_SECRET=
YC_IDENTITY_FACEBOOK_CLIENT_ID=
YC_IDENTITY_FACEBOOK_CLIENT_SECRET=
# Password reset links are logged until yc-message sends them (dev only).
YC_IDENTITY_LOG_RESET_LINKS=true

# Service client secrets for internal calls (ADR-021), at least 32
# characters. yc-identity and the calling service read the same variable.
YC_CART_SERVICE_SECRET=dev-cart-service-secret-32-chars!!

# Payment gateways (test-mode keys only)
STRIPE_API_KEY=
YOCO_API_KEY=

# Field encryption keys (dev only; 32 bytes)
YC_PAYMENT_CIPHER_KEY=dev-32-byte-key-replace-in-prod!
YC_MESSAGE_CIPHER_KEY=dev-32-byte-key-replace-in-prod!
YC_SHIPPING_CIPHER_KEY=dev-32-byte-key-replace-in-prod!
YC_GATEWAY_DB_URL=postgres://yc_gateway_app:devpass@localhost:5432/yc_gateway?sslmode=disable

# Local ports for `task run` (in containers every service listens on :8080)
YC_GATEWAY__HTTP__LISTEN=:8090
YC_IDENTITY__HTTP__LISTEN=:8081
YC_MONITOR__HTTP__LISTEN=:8082
YC_PRODUCT__HTTP__LISTEN=:8083
YC_PRICING__HTTP__LISTEN=:8084
YC_IMAGE__HTTP__LISTEN=:8085
YC_PREFERENCE__HTTP__LISTEN=:8086
YC_CART__HTTP__LISTEN=:8087
YC_GATEWAY__UPSTREAMS__IDENTITY=http://localhost:8081
YC_GATEWAY_COOKIE_SECURE=false
YC_GATEWAY__PLATFORM_HOSTS=admin.localhost

# Gateway self-registration (ADR-020 rule 7): the gateway's internal
# listener, and where it reaches each service
YC_GATEWAY_INTERNAL_URL=http://localhost:8091
YC_PRODUCT_ADVERTISE_URL=http://localhost:8083
YC_PRICING_ADVERTISE_URL=http://localhost:8084
YC_IMAGE_ADVERTISE_URL=http://localhost:8085
YC_PREFERENCE_ADVERTISE_URL=http://localhost:8086
YC_CART_ADVERTISE_URL=http://localhost:8087

# Exchange rates: frankfurter (default, no key) or exchangerate_host
YC_PRICING_RATES_PROVIDER=frankfurter
YC_PRICING_EXCHANGERATE_HOST_KEY=
